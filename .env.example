# Bu dosyayı .env adıyla kopyalayıp anahtarını yaz. .env GitHub'a gönderilmez (.gitignore).
# Türkçe özetler için aşağıdakilerden birinin başındaki # işaretini kaldırıp anahtarını yaz.
# Ücretsiz (önerilen): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Ücretsiz yedek; Gemini kotası dolunca kullanılır: https://console.groq.com/keys
# GROQ_API_KEY=
# Ücretli, en iyi kalite: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# LLM kotası dolunca ücretsiz çeviri yedeği (anahtarsız da çalışır; bunlar kotayı büyütür):
# MYMEMORY_EMAIL=senin@epostan.com
# DEEPL_API_KEY=
# İsteğe bağlı:
# DIPWATCH_LLM=gemini          # sağlayıcıyı zorla (claude / gemini / groq)
# DIPWATCH_MODEL=claude-opus-5-5
# DIPWATCH_EFOR=low

# Telegram bildirimleri (4. adım). Adımlar README'de: "Telegram bildirimleri".
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=
